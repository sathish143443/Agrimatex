# Environment variables for local development

# Postgres (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrimatex?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# App configuration
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT=3001

# OTP / SMS provider
OTP_PROVIDER="msg91"
MSG91_API_KEY="your-msg91-key"
MSG91_SENDER="AGRIMTX"

# Storage
STORAGE_PROVIDER="supabase"
STORAGE_BUCKET="agrimatex"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"

# Frontend
NEXT_PUBLIC_APP_NAME="Agri Marketplace"
NEXT_PUBLIC_APP_ENV="development"
