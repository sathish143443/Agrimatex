generator client {
  provider = "prisma-client-js"
}

// For local MVP, stable schema is configured in a single file. Production usage should add migrations and environment-based configs.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  BUYER
  ADMIN
  OPERATIONS
}

enum BusinessType {
  INDIVIDUAL
  TRADER
  WHOLESALER
  PROCESSOR
  EXPORTER
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD
  REMOVED
  SUSPENDED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  CANCELLED
  FINALIZED
}

enum AgreementStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CANCELLED
}

model User {
  id               String     @id @default(uuid())
  phone            String     @unique
  email            String?    @unique
  passwordHash     String?
  role             UserRole   @default(FARMER)
  preferredLanguage String?   @default("en")
  isVerified       Boolean    @default(false)
  isSuspended      Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  lastLoginAt      DateTime?

  farmerProfile    FarmerProfile?
  buyerProfile     BuyerProfile?
  listings         Listing[]
  enquiries        Enquiry[]
  offerSent        Offer[]    @relation("offerFromUser")
  offerReceived    Offer[]    @relation("offerToUser")
  messagesSent     Message[]  @relation("messagesSent")
  notifications    Notification[]

  @@index([role])
  @@index([phone])
}

model FarmerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  name             String
  state            String
  district         String
  village          String?
  aadhaarHash      String?
  gstIn            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([state, district])
}

model BuyerProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id])
  businessName     String?
  businessType     BusinessType @default(INDIVIDUAL)
  state            String?
  district         String?
  gstIn            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([businessType])
}

model ProductCategory {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  createdAt   DateTime  @default(now())
  listings    Listing[]
}

model Listing {
  id                String        @id @default(uuid())
  listingRef        String        @unique
  sellerId          String
  seller            User          @relation(fields: [sellerId], references: [id])
  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  productName       String
  variety           String?
  grade             String?
  moistureLevel     Float?
  quantityKg        Float
  unit              String        @default("kg")
  pricePerUnit      Float
  currency          String        @default("INR")
  state             String
  district          String
  qualitySpecs      Json?
  photos            Json?
  availabilityDate  DateTime?
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  enquiries        Enquiry[]
  offers           Offer[]

  @@index([categoryId])
  @@index([state, district])
  @@index([status])
  @@index([productName])
}

model Enquiry {
  id              String    @id @default(uuid())
  buyerId         String
  buyer           User      @relation(fields: [buyerId], references: [id])
  listingId       String?
  listing         Listing?  @relation(fields: [listingId], references: [id])
  requestedQty    Float
  requestedUnit   String
  offeredPrice    Float?
  message         String?
  status          String    @default("open")
  createdAt       DateTime  @default(now())

  offers          Offer[]
}

model Offer {
  id              String       @id @default(uuid())
  enquiryId       String?
  enquiry         Enquiry?     @relation(fields: [enquiryId], references: [id])
  listingId       String
  listing         Listing      @relation(fields: [listingId], references: [id])
  fromUserId      String
  fromUser        User         @relation("offerFromUser", fields: [fromUserId], references: [id])
  toUserId        String
  toUser          User         @relation("offerToUser", fields: [toUserId], references: [id])
  offeredPrice    Float
  quantity        Float
  quantityUnit    String
  status          OfferStatus  @default(PENDING)
  parentOfferId   String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([listingId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Conversation {
  id            String    @id @default(uuid())
  listingId     String?
  participants  String[]
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("messagesSent", fields: [senderId], references: [id])
  recipientId    String?
  content        String
  attachments    Json?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Agreement {
  id              String          @id @default(uuid())
  offerId         String
  buyerId         String
  sellerId        String
  agreedPrice     Float
  agreedQuantity  Float
  agreedUnit      String
  status          AgreementStatus @default(INITIATED)
  agreementDoc    Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  channel   String   @default("in_app")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
}
